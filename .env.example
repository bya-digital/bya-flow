NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Utilisé comme secours pour construire les liens de réinitialisation de mot
# de passe si l'en-tête "origin" n'est pas disponible (ex. en production).
# À renseigner avec l'URL de production une fois le déploiement Vercel fait.
NEXT_PUBLIC_SITE_URL=

# Aucune clé service_role n'est utilisée par l'application : toute la
# sécurité repose sur la RLS Supabase avec la clé anon/publishable
# ci-dessus. Ne l'ajoutez que si un besoin précis (bypass RLS contrôlé)
# apparaît explicitement dans le code.
